<header class="store-header">
    <div class="store-header__utility">
        <div class="container store-header__utility-inner">
            <a class="store-header__utility-link" href="#store-support">Trung tâm hỗ trợ</a>
            <span class="store-header__utility-separator" aria-hidden="true"></span>
            <a class="store-header__utility-link" href="@Url.Action("Index", "Register", new { area = "Store" })">Tạo tài khoản</a>
        </div>
    </div>

    <div class="container">
        <div class="store-header__main">
            <a class="store-brand" href="@Url.Content("~/")" aria-label="Website Bán hàng Online - Trang chủ">
                <span class="store-brand__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false"><path d="M3 10.5 4.5 4h15l1.5 6.5M4 10v10h16V10M8 20v-6h8v6M3 10.5c0 1.4 1 2.5 2.3 2.5S8 11.9 8 10.5c0 1.4 1 2.5 2.3 2.5s2.4-1.1 2.4-2.5c0 1.4 1 2.5 2.3 2.5s2.3-1.1 2.3-2.5c0 1.4 1 2.5 2.4 2.5s2.3-1.1 2.3-2.5" /></svg>
                </span>
                <span class="store-brand__name">Website Bán hàng Online</span>
            </a>

            <form class="store-search" action="@Url.Action("Index", "Products", new { area = "Store" })" method="get" role="search">
                <label class="visually-hidden" for="store-search-input">Tìm kiếm sản phẩm</label>
                <input id="store-search-input" name="q" type="search" maxlength="100" placeholder="Tìm kiếm sản phẩm..." autocomplete="off" />
                <button type="submit" aria-label="Tìm kiếm">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 5 5" /></svg>
                </button>
            </form>

            <a class="store-header__account" href="@Url.Action("Index", "Register", new { area = "Store" })">
                <span class="store-header__account-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5" /><path d="M5 20c.5-3.4 3.2-5.5 7-5.5s6.5 2.1 7 5.5" /></svg>
                </span>
                <span class="store-header__account-label">Tài khoản</span>
            </a>

            <a class="store-header__cart" href="#store-cart" aria-label="Giỏ hàng">
                <span class="store-header__cart-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h8.3a2 2 0 0 0 1.9-1.5L21 8H6" /><circle cx="10" cy="20" r="1.2" /><circle cx="18" cy="20" r="1.2" /></svg>
                </span>
                <span class="store-header__cart-label">Giỏ hàng</span>
            </a>
        </div>

        <nav class="store-nav" aria-label="Điều hướng cửa hàng">
            <a class="store-nav__link is-active" href="@Url.Content("~/")">Trang chủ</a>
            <a class="store-nav__link" href="#store-products">Sản phẩm</a>
            <a class="store-nav__link" href="#store-promotions">Khuyến mãi</a>
            <a class="store-nav__link" href="#store-support">Hỗ trợ</a>
        </nav>
    </div>
</header>
