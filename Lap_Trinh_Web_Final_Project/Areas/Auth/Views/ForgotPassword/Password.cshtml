@{
    ViewBag.Title = "Tạo mật khẩu mới";
    ViewBag.Buoc = 3;
    ViewBag.TongBuoc = 4;
    ViewBag.TenBuoc = "Tạo mật khẩu mới";
}

<div class="auth-step">
    <div class="text-center mb-4">
        <div class="auth-step__icon" aria-hidden="true">
            <i class="bi bi-shield-lock"></i>
        </div>

        <h1 class="auth-step__title h3 fw-bold mb-2">Tạo mật khẩu mới</h1>

        <p class="auth-step__description mb-0">
            Nhập mật khẩu mới để bảo vệ tài khoản của bạn.
        </p>
    </div>

    @Html.Partial("_Alert")

    <form method="post" action="@Url.Action("Password", "ForgotPassword")">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="password" class="form-label">Mật khẩu mới</label>

            <div class="input-group auth-input-group">
                <span class="input-group-text">
                    <i class="bi bi-lock" aria-hidden="true"></i>
                </span>
                <input id="password"
                       name="password"
                       type="password"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Nhập mật khẩu mới (ít nhất 8 ký tự)"
                       required
                       autofocus>
            </div>
        </div>

        <div class="mb-4">
            <label for="confirmPassword" class="form-label">Xác nhận mật khẩu mới</label>

            <div class="input-group auth-input-group">
                <span class="input-group-text">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                </span>
                <input id="confirmPassword"
                       name="confirmPassword"
                       type="password"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Nhập lại mật khẩu mới"
                       required>
            </div>
        </div>

        <button type="submit" class="btn auth-submit btn-lg w-100">
            Đặt lại mật khẩu
            <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
        </button>
    </form>
</div>