@{
    Layout = "~/Areas/Auth/Views/Shared/_AuthStepsLayout.cshtml";
    ViewBag.Title = "Hoàn tất đăng ký";
    ViewBag.Buoc = 3;
    ViewBag.TongBuoc = 3;
    ViewBag.TenBuoc = "Thông tin tài khoản";
}

<div class="auth-step">
    <div class="text-center mb-4">
        <div class="auth-step__icon" aria-hidden="true">
            <i class="bi bi-shield-lock"></i>
        </div>

        <h1 class="auth-step__title h3 fw-bold mb-2">Hoàn tất đăng ký</h1>

        <p class="auth-step__description mb-0">
            Email đã được xác minh. Nhập họ tên và tạo mật khẩu để hoàn tất.
        </p>
    </div>

    @Html.Partial("~/Views/Shared/_Alert.cshtml")

    <form method="post" action="@Url.Action("Password", "Register", new { area = "Store" })">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="fullName" class="form-label">Họ và tên</label>

            <div class="input-group auth-input-group">
                <span class="input-group-text">
                    <i class="bi bi-person" aria-hidden="true"></i>
                </span>
                <input id="fullName"
                       name="fullName"
                       type="text"
                       class="form-control"
                       value="@ViewBag.FullName"
                       placeholder="Nhập họ và tên"
                       autocomplete="name"
                       maxlength="255"
                       required
                       autofocus>
            </div>
        </div>

        <div class="mb-3">
            <label for="password" class="form-label">Mật khẩu</label>

            <div class="input-group auth-input-group">
                <span class="input-group-text">
                    <i class="bi bi-lock" aria-hidden="true"></i>
                </span>
                <input id="password"
                       name="password"
                       type="password"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Ít nhất 8 ký tự"
                       required>
            </div>
        </div>

        <div class="mb-4">
            <label for="confirmPassword" class="form-label">Xác nhận mật khẩu</label>

            <div class="input-group auth-input-group">
                <span class="input-group-text">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                </span>
                <input id="confirmPassword"
                       name="confirmPassword"
                       type="password"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Nhập lại mật khẩu"
                       required>
            </div>
        </div>

        <button type="submit" class="btn auth-submit btn-lg w-100">
            Hoàn tất đăng ký
            <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
        </button>
    </form>
</div>