<footer class="store-footer" id="store-support">
    <div class="container">
        <div class="store-footer__grid">
            <section class="store-footer__column">
                <a class="store-footer__brand" href="@Url.Content("~/")">
                    <span class="store-footer__brand-icon" aria-hidden="true">S</span>
                    <span>Website Bán hàng Online</span>
                </a>
                <p class="store-footer__description">Mua sắm tiện lợi, lựa chọn sản phẩm phù hợp mỗi ngày.</p>
            </section>

            <nav class="store-footer__column" aria-label="Thông tin cửa hàng">
                <h2 class="store-footer__title">Cửa hàng</h2>
                <a href="#store-products">Sản phẩm</a>
                <a href="#store-promotions">Ưu đãi</a>
                <a href="#store-support">Liên hệ</a>
            </nav>

            <nav class="store-footer__column" aria-label="Hỗ trợ khách hàng">
                <h2 class="store-footer__title">Hỗ trợ khách hàng</h2>
                <a href="#store-support">Hướng dẫn mua hàng</a>
                <a href="#store-support">Chính sách giao hàng</a>
                <a href="#store-support">Đổi trả và hoàn tiền</a>
            </nav>

            <nav class="store-footer__column" aria-label="Thông tin pháp lý">
                <h2 class="store-footer__title">Thông tin</h2>
                <a href="#store-support">Điều khoản dịch vụ</a>
                <a href="#store-support">Chính sách bảo mật</a>
                <a href="#store-support">Câu hỏi thường gặp</a>
            </nav>
        </div>

        <div class="store-footer__bottom">
            <span>&copy; @DateTime.Now.Year Website Bán hàng Online</span>
            <span class="store-footer__note">Đồ án học tập</span>
        </div>
    </div>
</footer>
